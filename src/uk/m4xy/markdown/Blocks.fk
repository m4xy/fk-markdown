import uk.m4xy.markdown.Inlines

// A document's blocks, read from its lines: headings, # or underlined; fenced and indented code;
// quotes; lists, of - * or +, or numbered, their items' lines indented to their text; rules; and
// paragraphs, of the lines between.
internal module Blocks {
  of(text: String): List<Block> = blocks(text.replace("\t", "    ").lines())

  private blocks(lines: List<String>): List<Block> = when (lines) {
    [] -> []
    [line, *rest] ->
      if (line.isBlank()) blocks(rest)
      else if (fenceOf(line).isSome()) fenced(line, rest)
      else when (headingOf(line)) {
        Some(heading) -> [heading] + blocks(rest)
        None ->
          if (isRule(line)) [Rule] + blocks(rest)
          else if (isQuoted(line)) quote(lines)
          else when (markerOf(line)) {
            Some(marker) -> listed(lines, marker)
            None ->
              if (indentOf(line) >= 4) indented(lines)
              else if (startsTable(lines)) table(lines)
              else paragraph(lines)
          }
      }
  }

  // ``` or ~~~, three or more, and what language the code's in.
  private fenceOf(line: String): Option<(String, Option<String>)> = {
    trimmed = line.trimStart()
    fence = trimmed.toList().takeWhile { it == '`' }.size
    tilde = trimmed.toList().takeWhile { it == '~' }.size
    count = max(fence, tilde)
    info = trimmed.drop(count).trim()
    if (indentOf(line) > 3 || count < 3 || (fence >= 3 && info.contains("`"))) None
    else Some((trimmed.take(count), if (info.isEmpty()) None else Some(info.substringBefore(" "))))
  }

  private fenced(opening: String, rest: List<String>): List<Block> = {
    (fence, language) = fenceOf(opening).getOrElse(("```", None))
    closes = (line: String) -> {
      trimmed = line.trim()
      trimmed.startsWith(
        fence,
      ) && trimmed.toList().all { it == fence.toList().firstOrNone().getOrElse('`') }
    }
    body = rest.takeWhile { !closes(it) }
    shift = indentOf(opening)
    code = body.map { it.drop(min(shift, indentOf(it))) }
    [CodeBlock(language, code.map { "$it\n" }.joinToString(""))] + blocks(rest.drop(body.size + 1))
  }

  private headingOf(line: String): Option<Block> = {
    trimmed = line.trimStart()
    level = trimmed.toList().takeWhile { it == '#' }.size
    after = trimmed.drop(level)
    if (indentOf(line) > 3 || level < 1 || level > 6 || (after.isNotEmpty() && !after.startsWith(" ")))
      None
    else {
      text = after.trim()
      closing = text.toList().reversed().takeWhile { it == '#' }.size
      before = text.dropLast(closing)
      content = if (closing > 0 && (before.isEmpty() || before.endsWith(" "))) before.trim() else text
      Some(Heading(level, Inlines.of(content)))
    }
  }

  private isRule(line: String): Boolean = {
    marks = line.toList().filter { it != ' ' }
    indentOf(line) <= 3 && marks.size >= 3 && when (marks) {
      [first, *_] -> (first == '-' || first == '*' || first == '_') && marks.all { it == first }
      [] -> false
    }
  }

  private isQuoted(line: String): Boolean = indentOf(line) <= 3 && line.trimStart().startsWith(">")

  // The quote's lines, each without its >, as blocks of their own.
  private quote(lines: List<String>): List<Block> = {
    quoted = lines.takeWhile { isQuoted(it) }
    inside = quoted.map { line ->
      after = line.trimStart().drop(1)
      if (after.startsWith(" ")) after.drop(1) else after
    }
    [Quote(blocks(inside))] + blocks(lines.drop(quoted.size))
  }

  // A list item's marker: - * or +, or a number then . or ); and where its text starts.
  private type Marker(bullet: Char, number: Option<Int>, column: Int)

  private markerOf(line: String): Option<Marker> = {
    indent = indentOf(line)
    rest = line.drop(indent).toList()
    if (indent > 3) None
    else when (rest) {
      [c, ' ', *_] if c == '-' || c == '*' || c == '+' -> Some(
        Marker(c, None, indent + 2 + spacesAfter(rest.drop(2))),
      )
      [c] if c == '-' || c == '*' || c == '+' -> Some(Marker(c, None, indent + 2))
      else -> {
        digits = rest.takeWhile { it.isDigit() }
        after = rest.drop(digits.size)
        when (after) {
          [c, ' ', *_] if (c == '.' || c == ')') && digits.size >= 1 && digits.size <= 9 -> Some(
            Marker(
              c,
              text(digits).toIntOrNone(),
              indent + digits.size + 2 + spacesAfter(after.drop(2)),
            ),
          )
          else -> None
        }
      }
    }
  }

  // Spaces after a marker's one, up to three more, as its text starts after them.
  private spacesAfter(cs: List<Char>): Int = {
    spaces = cs.takeWhile { it == ' ' }.size
    if (spaces >= 4 || spaces == cs.size) 0 else spaces
  }

  // A list's items, each its marker's line, then the lines indented to its text, or blank, or, after
  // a line of its own, a line that carries on its paragraph; then the blocks after the list.
  private listed(lines: List<String>, marker: Marker): List<Block> = {
    (items, loose, rest) = items(lines, marker, [], false)
    tight = !loose
    parsed = items.map { blocks(it) }
    made = when (marker.number) {
      Some(start) -> NumberedList(start, parsed, tight)
      None -> BulletList(parsed, tight)
    }
    [made] + blocks(rest)
  }

  private items(
    lines: List<String>,
    marker: Marker,
    found: List<List<String>>,
    loose: Boolean,
  ): (List<List<String>>, Boolean, List<String>) = when (lines) {
    [line, *rest] if markerOf(line).map { same(it, marker) }.getOrElse(false) -> {
      m = markerOf(line).getOrElse(marker)
      (body, after) = itemLines(rest, m.column, [line.drop(m.column)], false)
      trailing = body.reversed().takeWhile { it.isBlank() }.size
      inner = body.dropLast(trailing)
      next = after.firstOrNone().flatMap { markerOf(it) }.map { same(it, marker) }.getOrElse(false)
      gapInside = inner.drop(1).dropLast(1).any { it.isBlank() } && hasBlocksApart(inner)
      items(after, marker, found + [inner], loose || (trailing > 0 && next) || gapInside)
    }
    else -> (found, loose, lines)
  }

  // Whether an item's lines have a blank line between two of its blocks, not inside code.
  private hasBlocksApart(lines: List<String>): Boolean =
    lines.zip(lines.drop(1)).any { a, b -> a.isBlank() && !b.isBlank() && indentOf(b) < 4 }

  private same(
    a: Marker,
    b: Marker,
  ): Boolean = a.bullet == b.bullet && a.number.isSome() == b.number.isSome()

  // An item's lines after its first, without the indent of its text, and the lines after it.
  private itemLines(
    lines: List<String>,
    column: Int,
    found: List<String>,
    blank: Boolean,
  ): (List<String>, List<String>) = when (lines) {
    [] -> (found, [])
    [line, *rest] ->
      if (line.isBlank()) itemLines(rest, column, found + [""], true)
      else if (indentOf(line) >= column) itemLines(rest, column, found + [line.drop(column)], false)
      else if (!blank && carriesOn(line, found)) itemLines(rest, column, found + [line], false)
      else (found, lines)
  }

  // Whether line, not indented, still carries on the paragraph the item's last line is in.
  private carriesOn(line: String, found: List<String>): Boolean =
    found.lastOrNone().map { last -> !last.isBlank() && fenceOf(last).isNone() }.getOrElse(false) &&
      !startsBlock(line)

  private startsBlock(line: String): Boolean =
    fenceOf(line).isSome() || headingOf(line).isSome() || isRule(line) || isQuoted(line) ||
      markerOf(line).isSome()

  // Whether lines start with a table: a row, then a delimiter row with as many cells.
  private startsTable(lines: List<String>): Boolean = when (lines) {
    [header, delimiter, *_] -> header.contains("|") && alignmentsOf(delimiter).map { a ->
      a.size == cellsOf(header).size
    }.getOrElse(false)
    else -> false
  }

  private table(lines: List<String>): List<Block> = {
    header = lines.firstOrNone().getOrElse("")
    alignments = lines.drop(1).firstOrNone().flatMap { alignmentsOf(it) }.getOrElse([])
    body = lines.drop(2).takeWhile { !it.isBlank() && !startsBlock(it) }
    width = alignments.size
    // A row of more cells than the header's has the rest left out, and one of fewer, empty ones.
    fitted = (row: String) -> {
      cells = cellsOf(row).take(width)
      (cells + (0..<(width - cells.size)).map { "" }).map { Inlines.of(it) }
    }
    [Table(alignments, fitted(header), body.map { fitted(it) })] + blocks(lines.drop(2 + body.size))
  }

  // A delimiter row's alignments, or None if it isn't one.
  private alignmentsOf(line: String): Option<List<Alignment>> = {
    cells = cellsOf(line)
    aligned = cells.map { cell ->
      left = cell.startsWith(":")
      right = cell.endsWith(":")
      dashes = cell.removePrefix(":").removeSuffix(":")
      if (dashes.isEmpty() || !dashes.toList().all { it == '-' }) None
      else Some(if (left && right) Center else if (left) Left else if (right) Right else Unaligned)
    }
    if (cells.isNotEmpty() && aligned.all { it.isSome() } && line.contains("-")) Some(
      aligned.map { it.getOrElse(Unaligned) },
    )
    else None
  }

  // A row's cells, between its pipes, each trimmed: a pipe escaped, \|, is in its cell.
  private cellsOf(row: String): List<String> = {
    trimmed = row.trim()
    inner = trimmed.removePrefix("|")
    bounded = if (inner.endsWith("|") && !inner.endsWith("\\|")) inner.dropLast(1) else inner
    split(bounded.toList(), [], []).map { it.trim() }
  }

  private split(cs: List<Char>, cell: List<Char>, cells: List<String>): List<String> = when (cs) {
    [] -> cells + [text(cell)]
    ['\\', '|', *rest] -> split(rest, cell + ['|'], cells)
    ['|', *rest] -> split(rest, [], cells + [text(cell)])
    [c, *rest] -> split(rest, cell + [c], cells)
  }

  // Indented code: lines indented four or more, and blank lines between them.
  private indented(lines: List<String>): List<Block> = {
    taken = lines.takeWhile { it.isBlank() || indentOf(it) >= 4 }
    trailing = taken.reversed().takeWhile { it.isBlank() }.size
    code = taken.dropLast(trailing).map { it.drop(min(4, indentOf(it))) }
    [CodeBlock(None, code.map { "$it\n" }.joinToString(""))] + blocks(
      lines.drop(taken.size - trailing),
    )
  }

  // A paragraph's lines, to a blank one or one that starts a block, or, underlined, a heading.
  private paragraph(lines: List<String>): List<Block> = {
    (taken, setext) = paragraphLines(lines.drop(1), [lines.firstOrNone().getOrElse("")])
    text = taken.map { it.trimStart() }.joinToString("\n").trimEnd()
    rest = lines.drop(taken.size + (if (setext.isSome()) 1 else 0))
    when (setext) {
      Some(level) -> [Heading(level, Inlines.of(text))] + blocks(rest)
      None -> [Paragraph(Inlines.of(text))] + blocks(rest)
    }
  }

  private paragraphLines(lines: List<String>, found: List<String>): (List<String>, Option<Int>) =
    when (lines) {
      [line, *rest] ->
        if (line.isBlank()) (found, None)
        else if (underline(line, '=')) (found, Some(1))
        else if (underline(line, '-')) (found, Some(2))
        else if (startsBlock(line) && !numberedFromOtherThanOne(line)) (found, None)
        else if (startsTable(lines)) (found, None)
        else paragraphLines(rest, found + [line])
      [] -> (found, None)
    }

  // A numbered item that doesn't start at 1, which doesn't break a paragraph: 1985. was a year.
  private numberedFromOtherThanOne(line: String): Boolean =
    markerOf(line).flatMap { it.number }.map { it != 1 }.getOrElse(false)

  private underline(line: String, c: Char): Boolean = {
    trimmed = line.trim()
    indentOf(line) <= 3 && trimmed.isNotEmpty() && trimmed.toList().all { it == c }
  }

  private indentOf(line: String): Int = line.toList().takeWhile { it == ' ' }.size

  private text(cs: List<Char>): String = cs.map { it.toString() }.joinToString("")
}
